{
  "manifest_version": 3,
  "name": "Assistente de Live Shopee",
  "version": "0.4.0",
  "description": "Ajuda o apresentador de lives da Shopee Brasil: lê IDs de produto pedidos no chat, favorita na Shopee, marca os produtos na tela de Adicionar Produtos da live, para você confirmar, e mostra a sacola da live numerada, com busca, num painel maior e ajustável, em grade de fotos; um clique na foto coloca o produto no ar.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://live.shopee.com.br/*"],
      "js": ["src/live/pageBridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://live.shopee.com.br/*"],
      "js": [
        "src/lib/ids.js",
        "src/lib/batch.js",
        "src/lib/match.js",
        "src/lib/selectors.js",
        "src/lib/dom.js",
        "src/live/addProducts.js",
        "src/live/bag.js",
        "src/live/layout.js",
        "src/live/showGuard.js",
        "src/live/panel.js",
        "src/live/bagTab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.shopee.com.br/*"],
      "exclude_matches": ["https://live.shopee.com.br/*"],
      "js": ["src/lib/selectors.js", "src/lib/dom.js", "src/shopee/hand.js"],
      "run_at": "document_idle"
    }
  ]
}
