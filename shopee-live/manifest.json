{
  "manifest_version": 3,
  "name": "Assistente de Live Shopee",
  "version": "0.2.0",
  "description": "Ajuda o apresentador de lives da Shopee Brasil: lê IDs de produto pedidos no chat, favorita na Shopee e marca os produtos na tela de Adicionar Produtos da live, para você confirmar.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://live.shopee.com.br/*"],
      "js": [
        "src/lib/ids.js",
        "src/lib/batch.js",
        "src/lib/match.js",
        "src/lib/selectors.js",
        "src/lib/dom.js",
        "src/live/addProducts.js",
        "src/live/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.shopee.com.br/*"],
      "exclude_matches": ["https://live.shopee.com.br/*"],
      "js": ["src/lib/selectors.js", "src/lib/dom.js", "src/shopee/hand.js"],
      "run_at": "document_idle"
    }
  ]
}
